# Copy to .env.local
#
# Must be a full URL with http(s):// — NOT "/api" alone (that hits Next.js and returns HTML 404).
# Must end with /api (Nest global prefix). Match backend PORT (default 3001).
#
# After any change: stop `next dev` and start it again (NEXT_PUBLIC_* is read at startup).
NEXT_PUBLIC_API_BASE=http://localhost:3001/api

# Google OAuth (NextAuth)
# Create in Google Cloud Console → OAuth client (Web application)
# Authorized JavaScript origins:
#   http://localhost:3000
# Authorized redirect URIs:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth required
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Server-only (no NEXT_PUBLIC_ prefix — never sent to the browser). Must match INTERNAL_API_KEY in
# backend/.env. Used exclusively by Next.js Route Handlers to call user-scoped backend endpoints
# after resolving the session server-side. Generate with `openssl rand -hex 32`.
INTERNAL_API_KEY=
