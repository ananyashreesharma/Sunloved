+/**
+ Holds a weak reference to a possibly non-`Sendable` event emitter so it can be captured by the
+ `@Sendable` closure scheduled onto the runtime without the compiler flagging `self` as being sent
+ across an isolation boundary. The box itself has no mutable state of its own to race on - `value` is
+ read at most once per scheduled closure invocation, on whichever thread the runtime resumes it on.
+ */
+private final class WeakEmitterBox<T: AnyObject>: @unchecked Sendable {
+  weak var value: T?
+
+  init(_ value: T?) {
+    self.value = value
+  }
+}
