{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE": "http://localhost:3001/api" }
    },
    "preview": {
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_BASE": "https://api.skinlens.in/api", "EXPO_PUBLIC_SITE_URL": "https://skinlens.in" }
    },
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_BASE": "https://api.skinlens.in/api", "EXPO_PUBLIC_SITE_URL": "https://skinlens.in" }
    }
  },
  "submit": {
    "production": {}
  }
}
