{
  "expo": {
    "name": "SkinLens",
    "slug": "skinlens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "skinlens",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "in.knowbetter.app",
      "infoPlist": {
        "NSCameraUsageDescription": "SkinLens uses your camera to read ingredient labels and to take progress photos, which stay on your phone.",
        "CFBundleLocalizations": [
          "en",
          "es",
          "ar"
        ]
      }
    },
    "android": {
      "package": "in.knowbetter.app",
      "adaptiveIcon": {
        "backgroundColor": "#F2ECE1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2ECE1",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SkinLens uses your camera to read ingredient labels and to take progress photos, which stay on your phone.",
          "photosPermission": "SkinLens lets you pick a progress photo from your library. It stays on your phone."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
