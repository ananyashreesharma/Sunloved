# Production Environment Configuration
NODE_ENV=production
PORT=2000

# Frontend URL (Update with your production domain)
FRONTEND_URL=https://your-production-domain.com

# Supabase Database - Production
# IMPORTANT: Replace with your actual credentials
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@db.pdpcbrekehogegvkdaou.supabase.co:6543/postgres?pgbouncer=true&connection_limit=20"
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@db.pdpcbrekehogegvkdaou.supabase.co:5432/postgres"

# API Security
ADMIN_API_KEY=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# CORS Origins (comma-separated for multiple domains)
ALLOWED_ORIGINS=https://your-production-domain.com
