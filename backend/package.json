{
  "name": "sunloved-backend",
  "version": "1.0.0",
  "description": "Backend API for Sunloved skincare recommendation platform",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:supabase": "node scripts/migrate-supabase.js",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:categories": "ts-node prisma/seed-categories.ts",
    "prisma:seed:critical-ingredients": "ts-node prisma/seed-critical-ingredients.ts",
    "prisma:rate-ingredients": "ts-node prisma/rate-ingredients-cosing.ts",
    "prisma:fetch-ingredients": "ts-node prisma/fetch-catalog-ingredients.ts",
    "prisma:fetch-ingredients-v2": "ts-node prisma/fetch-catalog-ingredients-v2.ts",
    "scrape:incidecoder": "ts-node src/modules/scraper/incidecoder.scraper.ts",
    "scrape:incidecoder:dry": "ts-node src/modules/scraper/incidecoder.scraper.ts --dry-run --limit=10",
    "scrape:cosing": "ts-node src/modules/scraper/cosing.scraper.ts",
    "scrape:cosing:dry": "ts-node src/modules/scraper/cosing.scraper.ts --dry-run --limit=10",
    "prisma:fetch-retail-metadata": "ts-node prisma/fetch-catalog-retail-metadata.ts",
    "prisma:seed:body-hair-catalog": "ts-node prisma/seed-india-body-hair-catalog.ts",
    "prisma:export-missing-ingredients": "ts-node prisma/export-missing-ingredients.ts",
    "prisma:verify-catalog": "ts-node prisma/verify-catalog.ts",
    "prisma:prune-unverified": "ts-node prisma/prune-unverified-products.ts",
    "prisma:enrich-ingredients": "ts-node prisma/enrich-ingredients.ts",
    "prisma:audit-ingredients": "ts-node prisma/audit-ingredients.ts",
    "prisma:import-product-ingredients-csv": "ts-node prisma/import-product-ingredients-csv.ts",
    "prisma:import-skincare-cleansers-toners": "ts-node prisma/import-product-ingredients-csv.ts --file=prisma/data/product-ingredients-skincare-cleansers-toners.csv",
    "prisma:generate:makeup-catalog": "ts-node prisma/scripts/generate-india-makeup-catalog-ndjson.ts",
    "prisma:seed:makeup-catalog": "ts-node prisma/seed-india-makeup-catalog.ts",
    "db:setup": "npm run prisma:migrate && npm run prisma:seed",
    "db:supabase": "npm run prisma:reset",
    "prisma:reset": "prisma migrate reset --force",
    "check:world-labels": "ts-node --transpile-only prisma/check-world-labels.ts",
    "sync:shared": "node scripts/sync-shared.js",
    "prebuild": "node scripts/sync-shared.js"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^6.19.0",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.7.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "dotenv": "^17.4.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.4.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "twilio": "^5.13.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.2.1",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "prisma": "^6.19.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
