# Copy this file to `backend/.env` and fill in real values (never commit `.env`).

PORT=3001

# ─── Postgres (Supabase) ─────────────────────────────────────────────────────
# Dashboard: Project Settings → Database → Connection string → URI
# Add ?sslmode=require so Prisma connects over TLS.
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# ─── Twilio (WhatsApp OTP) ────────────────────────────────────────────────────
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# WhatsApp sender number in E.164 format, prefixed with "whatsapp:"
# For Sandbox testing use: whatsapp:+14155238886
# For production: use your own approved WhatsApp Business number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ─── OpenAI (ingredient enrichment for community contributions) ─────────────────
# platform.openai.com → API keys. Optional in dev — enrichment falls back to a null
# zone/description for unrecognized ingredients if this is unset.
OPENAI_API_KEY=

# ─── Resend (mobile email OTP) ────────────────────────────────────────────────
# resend.com → API Keys. Without this set, the email-OTP endpoint logs the code server-side
# instead of emailing it (fine for local dev, not for production — real users need real email).
# RESEND_FROM_EMAIL must be an address on a domain you've verified in Resend (or their shared
# onboarding@resend.dev sender while testing).
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ─── Misc ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# Shared secret trusted only by the Next.js server (never exposed to the browser). Generate with
# `openssl rand -hex 32`. Must match INTERNAL_API_KEY in frontend/.env.
INTERNAL_API_KEY=

# ─── Mobile email login (JWT bearer tokens) ───────────────────────────────────
# The mobile app can't use the INTERNAL_API_KEY pattern above (that's a server-to-server secret,
# never safe to embed in a public client) — it authenticates with a signed JWT it holds itself
# instead. Generate both with `openssl rand -hex 32`; use two different values.
JWT_SECRET=
JWT_REFRESH_SECRET=
