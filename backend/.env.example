# Copy to .env and fill in values from Supabase → Project Settings → Database.

# HTTP port for Nest (frontend NEXT_PUBLIC_API_BASE must point at this host:port + /api)
PORT=3001

# Transaction pooler (port 6543) — fine for many Prisma queries at runtime.
# Example: postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"

# Direct connection (port 5432) — use for migrations. Omit if you only use DATABASE_URL.
# Example: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/postgres"
