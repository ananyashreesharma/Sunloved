// Sunloved Database Schema - Reshaped
// Comprehensive schema for catalog, ethics, skin fit, comparisons, and user features

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// 1. CATALOG TABLES
// ============================================================================

model Brand {
  id      String  @id @default(uuid())
  name    String  @unique
  country String?
  website String? @db.Text

  // Brand-level ethics
  isCrueltyFree            Boolean   @default(false)
  isVeganBrand             Boolean   @default(false) // True only if ALL products are vegan
  crueltyFreeSource        String? // 'PETA', 'Leaping Bunny', 'Self-reported'
  crueltyFreeLastCheckedAt DateTime?
  notes                    String?   @db.Text

  // Relations
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isCrueltyFree])
  @@map("brands")
}

model Product {
  id      String @id @default(uuid())
  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  name        String
  category    String // 'cleanser', 'serum', 'moisturizer', 'sunscreen', etc.
  subCategory String? // 'gel cleanser', 'cream cleanser', 'matte lipstick'

  // Volume & packaging
  volumeValue Decimal? @db.Decimal(10, 2)
  volumeUnit  String? // 'ml', 'g', 'oz'

  // Description & media
  description String? @db.Text
  imageUrl    String? @db.Text
  url         String? @db.Text // Canonical product page
  barcode     String? // EAN/UPC

  // Pricing
  price        Decimal? @db.Decimal(10, 2)
  currency     String?  @default("USD") // 'USD', 'INR'
  pricePerUnit Decimal? @db.Decimal(10, 4) // Derived: price / volumeValue

  // Relationships & metadata
  originalProductId String? // FK to products.id if this is a dupe
  originalProduct   Product?  @relation("ProductDupes", fields: [originalProductId], references: [id])
  dupes             Product[] @relation("ProductDupes")

  source          String? // 'OpenBeautyFacts', 'Sephora', 'Amazon'
  sourceProductId String? // Original external ID
  isDiscontinued  Boolean   @default(false)
  lastScrapedAt   DateTime?

  // Relations
  ingredients       ProductIngredient[]
  ethics            ProductEthics?
  skinTypes         ProductSkinType[]
  skinConcerns      ProductSkinConcern[]
  comparisonsAsBase Comparison[]         @relation("BaseProduct")
  comparisonsAsAlt  Comparison[]         @relation("AltProduct")
  priceHistory      PriceHistory[]
  prices            ProductPrice[]
  reviews           ProductReview[]
  wishlistItems     WishlistItem[]
  favorites         Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
  @@index([barcode])
  @@index([category, subCategory])
  @@index([price])
  @@index([source])
  @@map("products")
}

model Ingredient {
  id          String  @id @default(uuid())
  inciName    String  @unique // Canonical INCI name
  displayName String? // Nice user-facing name
  aliases     Json? // Alternate spellings / trade names

  // Function & role
  function    String? // 'humectant', 'emollient', 'preservative', 'UV filter', 'pigment'
  description String? @db.Text

  // Safety & classification flags
  isFragrance Boolean @default(false)
  isParaben   Boolean @default(false)
  isPhthalate Boolean @default(false)
  isSulfate   Boolean @default(false)
  isTalc      Boolean @default(false)
  isPfas      Boolean @default(false)

  // Sensitivity / safety metadata
  comedogenicRating Int? // 0-5
  irritancyRating   Int? // 0-5
  sensitivityFlags  Json? // {"rosacea": true, "fungal_acne": false}
  regulatoryNotes   String? @db.Text // "EU: max 1% in leave-on", "Rinse-off only"

  // Metadata
  source         String?
  lastReviewedAt DateTime?

  // Relations
  products ProductIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isFragrance])
  @@index([isParaben])
  @@index([isSulfate])
  @@map("ingredients")
}

model ProductIngredient {
  id           String     @id @default(uuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Restrict)

  position          Int // 1-based order from ingredient list
  concentration     Decimal? @db.Decimal(7, 4) // If known
  concentrationUnit String? // '%', 'ppm'
  isStarIngredient  Boolean  @default(false)
  rawText           String? // Original raw label substring for debugging

  createdAt DateTime @default(now())

  @@unique([productId, ingredientId])
  @@unique([productId, position])
  @@index([productId])
  @@index([ingredientId])
  @@map("product_ingredients")
}

// ============================================================================
// 2. ETHICS & SAFETY
// ============================================================================

model ProductEthics {
  id        String  @id @default(uuid())
  productId String  @unique
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Ethics flags (null = inherit from brand)
  isCrueltyFree Boolean? // If null → inherit from brand
  isVegan       Boolean? // If null → inherit from brand
  isOrganic     Boolean?

  // Free-from style tags (can be computed or stored)
  isFragranceFree    Boolean @default(false)
  isAlcoholFree      Boolean @default(false)
  isEssentialOilFree Boolean @default(false)
  isParabenFree      Boolean @default(false)
  isSulfateFree      Boolean @default(false)
  isPhthalateFree    Boolean @default(false)
  isTalcFree         Boolean @default(false)
  isPfasFree         Boolean @default(false)

  // Metadata
  source         String? // 'computed', 'brand_claim', 'user_verified'
  lastVerifiedAt DateTime?
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isVegan])
  @@index([isCrueltyFree])
  @@index([isFragranceFree])
  @@index([isParabenFree])
  @@map("product_ethics")
}

// ============================================================================
// 3. SKIN FIT: TYPES & CONCERNS
// ============================================================================

model SkinType {
  id          String  @id @default(uuid())
  code        String  @unique // 'normal', 'oily', 'dry', 'combination', 'sensitive'
  label       String // 'Normal', 'Oily'
  description String? @db.Text

  // Relations
  products ProductSkinType[]
  users    User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skin_types")
}

model SkinConcern {
  id          String  @id @default(uuid())
  code        String  @unique // 'acne', 'hyperpigmentation', 'aging', 'redness', etc.
  label       String
  description String? @db.Text

  // Relations
  products ProductSkinConcern[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skin_concerns")
}

model ProductSkinType {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinTypeId String
  skinType   SkinType @relation(fields: [skinTypeId], references: [id], onDelete: Restrict)

  score  Int? // 1-5 indicating how suitable
  source String? // 'algorithm', 'expert', 'user_votes'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, skinTypeId])
  @@index([skinTypeId, productId])
  @@map("product_skin_types")
}

model ProductSkinConcern {
  id            String      @id @default(uuid())
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  skinConcernId String
  skinConcern   SkinConcern @relation(fields: [skinConcernId], references: [id], onDelete: Restrict)

  role   String? // 'targets', 'safe_for', 'avoid_if'
  score  Int? // 1-5
  source String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, skinConcernId, role])
  @@index([skinConcernId, productId])
  @@map("product_skin_concerns")
}

// ============================================================================
// 4. COMPARISONS / DUPES
// ============================================================================

model Comparison {
  id            String  @id @default(uuid())
  baseProductId String
  baseProduct   Product @relation("BaseProduct", fields: [baseProductId], references: [id], onDelete: Cascade)
  altProductId  String
  altProduct    Product @relation("AltProduct", fields: [altProductId], references: [id], onDelete: Cascade)

  // Scores
  similarityScore  Decimal  @db.Decimal(5, 2) // 0-100
  ecoScore         Decimal? @db.Decimal(5, 2) // Higher = more eco-friendly
  sensitivityScore Decimal? @db.Decimal(5, 2) // Higher = better for sensitive skin

  // Metadata
  matchType            String // 'ingredient_similarity', 'eco_friendly', 'sensitive_skin', 'mixed'
  overlapPercentage    Decimal? @db.Decimal(5, 2) // Percentage of shared ingredients
  sharedKeyIngredients Json? // List of ingredient_ids or names
  priceDiff            Decimal? @db.Decimal(10, 2) // alt_price - base_price
  pricePerUnitDiff     Decimal? @db.Decimal(10, 4)
  notes                String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([baseProductId, altProductId])
  @@index([baseProductId])
  @@index([altProductId])
  @@index([baseProductId, matchType, similarityScore(sort: Desc)])
  @@map("comparisons")
}

// ============================================================================
// 5. USER-FACING TABLES
// ============================================================================

model User {
  id           String    @id @default(uuid())
  email        String?   @unique // Nullable if using OAuth
  username     String    @unique
  passwordHash String? // Nullable if using external auth
  displayName  String?
  skinTypeId   String?
  skinType     SkinType? @relation(fields: [skinTypeId], references: [id])
  skinConcerns Json? // Or link via join table if needed

  // Relations
  reviews       ProductReview[]
  wishlistItems WishlistItem[]
  favorites     Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model ProductReview {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  rating  Int // 1-5
  title   String?
  comment String? @db.Text

  // Optional context fields
  userSkinTypeId   String? // Snapshot at review time
  userSkinConcerns Json? // Snapshot
  usedForDuration  String? // '1 week', '3 months'
  wouldRepurchase  Boolean?

  // Moderation
  isVerifiedPurchase Boolean @default(false)
  isHidden           Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([productId, rating])
  @@index([userId])
  @@map("product_reviews")
}

model Wishlist {
  id     String @id @default(uuid())
  userId String
  name   String // 'Morning routine', 'Wishlist – Sephora sale'

  // Relations
  items WishlistItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
  @@map("wishlist_items")
}

model Favorite {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
  @@map("favorites")
}

// ============================================================================
// 6. PRICING & RETAILERS (keeping existing structure)
// ============================================================================

model Retailer {
  id   String  @id @default(uuid())
  name String  @unique
  slug String  @unique
  url  String? @db.Text

  // Relations
  prices ProductPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("retailers")
}

model ProductPrice {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailerId String
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)

  amount        Decimal  @db.Decimal(10, 2)
  currency      String   @default("USD")
  lastCheckedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, retailerId])
  @@index([productId])
  @@index([retailerId])
  @@map("product_prices")
}

model PriceHistory {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  @@index([productId, recordedAt])
  @@map("price_history")
}
