// Sunloved Database Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id              String   @id @default(uuid())
  name            String
  brand           String
  volume          String
  description     String   @db.Text
  category        String?  // 'serum', 'moisturizer', 'sunscreen', etc.
  pricePerUnit    Float?
  currentPrice    Float?
  productUrl      String?  @db.Text
  imageUrl        String?  @db.Text
  originalProduct String?  // If it's an alternative to another product
  
  // Relations
  ingredients     ProductIngredient[]
  ethicsData      EthicsData?
  comparisonsAsOriginal    Comparison[] @relation("OriginalProduct")
  comparisonsAsAlternative Comparison[] @relation("AlternativeProduct")
  priceHistory    PriceHistory[]
  prices          ProductPrice[]
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([brand])
  @@index([category])
  @@map("products")
}

model Ingredient {
  id              String   @id @default(uuid())
  name            String   @unique
  scientificName  String?
  category        String?  // 'antioxidant', 'humectant', 'emollient', etc.
  function        String?  @db.Text
  isIrritant      Boolean  @default(false)
  fungalAcneSafe  Boolean  @default(true)
  
  // Relations
  products        ProductIngredient[]
  
  createdAt       DateTime @default(now())
  
  @@index([name])
  @@map("ingredients")
}

model ProductIngredient {
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  ingredientId  String
  position      Int        // Order in ingredient list
  concentration String?    // 'high', 'medium', 'low' if known
  
  @@id([productId, ingredientId])
  @@map("product_ingredients")
}

model EthicsData {
  id              String   @id @default(uuid())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String   @unique
  
  crueltyFree     Boolean  @default(false)
  vegan           Boolean  @default(false)
  fragranceFree   Boolean  @default(false)
  alcoholFree     Boolean  @default(false)
  fungalAcneSafe  Boolean  @default(false)
  parabenFree     Boolean  @default(false)
  sulfateFree     Boolean  @default(false)
  siliconesFree   Boolean  @default(false)
  
  lastVerifiedAt  DateTime
  sourceUrl       String?  @db.Text
  
  updatedAt       DateTime @updatedAt
  
  @@map("ethics_data")
}

model Comparison {
  id                    String   @id @default(uuid())
  
  originalProduct       Product  @relation("OriginalProduct", fields: [originalProductId], references: [id], onDelete: Cascade)
  originalProductId     String
  
  alternativeProduct    Product  @relation("AlternativeProduct", fields: [alternativeProductId], references: [id], onDelete: Cascade)
  alternativeProductId  String
  
  similarityScore       Float    // 0-100
  savingsPercent        Int
  matchType             String   // 'closest-match', 'best-value', 'sensitive-safe'
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@unique([originalProductId, alternativeProductId])
  @@index([originalProductId])
  @@index([matchType])
  @@map("comparisons")
}

model PriceHistory {
  id          String   @id @default(uuid())
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  price       Float
  recordedAt  DateTime @default(now())
  
  @@index([productId, recordedAt])
  @@map("price_history")
}

model Retailer {
  id          String   @id @default(uuid())
  name        String   @unique  // 'Sephora', 'Amazon', 'Ulta', etc.
  slug        String   @unique  // 'sephora', 'amazon', 'ulta'
  url         String?  // Base URL of retailer
  
  // Relations
  prices      ProductPrice[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@map("retailers")
}

model ProductPrice {
  id              String   @id @default(uuid())
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  retailer        Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  retailerId      String
  
  amount          Float    // Price value
  currency        String   @default("USD")
  lastCheckedAt   DateTime @default(now())
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@unique([productId, retailerId])
  @@index([productId])
  @@index([retailerId])
  @@map("product_prices")
}
